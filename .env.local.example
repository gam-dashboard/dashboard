# Frontend/API connectivity
# Set this to true if you want MapView to prefer the DB-backed /api/projects endpoint.
VITE_USE_DB_API=false

# Optional: override the API origin when the frontend and API are deployed separately.
# Example local API server: http://localhost:10000
# Example Render API server: https://your-render-service.onrender.com
VITE_API_BASE_URL=

# Server-side chatbot / LLM configuration
# Required for /api/chat. Do NOT prefix these with VITE_.
OPENAI_API_KEY=

# Optional: override the chat model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenAI-compatible base URL for a different provider/proxy.
OPENAI_BASE_URL=

# Optional: allow browser clients from other origins to call the Express API.
# Example local frontend origin: http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Postgres connection string for Render or another Postgres host.
# Example: ******HOST:5432/DATABASE
DATABASE_URL=

# Optional: force SSL when your Postgres provider requires it (Render usually does).
PGSSLMODE=require

# Directory containing the per-post JSON files used by the importer.
# Example: /home/runner/work/dashboard/dashboard/data/json
PROJECT_JSON_DATA_DIR=

# Optional directory containing importer enrichment CSVs such as *locations.csv
PROJECT_LOCATIONS_CSV_DIR=

# Optional override for the Ushahidi posts endpoint used by the sync job.
USHAHIDI_POSTS_API_URL=https://globalactionmosaic.api.ushahidi.io/api/v5/posts/

# Optional sync tuning controls.
USHAHIDI_PAGE_SIZE=50
USHAHIDI_MAX_PAGES=20

# Optional shared reverse-geocode cache path for periodic sync.
GEOCODE_CACHE_PATH=
