# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-your-api-key-here

# Optional: Customize the API model (default: gpt-4o-mini)
# VITE_OPENAI_MODEL=gpt-4o-mini

# Optional: enable the Postgres-backed API compatibility layer in the frontend.
# Leave this false to preserve the current CSV-only behavior.
VITE_USE_DB_API=false

# Optional: override the API origin when the frontend and API are deployed separately.
# Example: https://your-render-service.onrender.com
VITE_API_BASE_URL=

# Postgres connection string for Render or another Postgres host.
# Example: ******HOST:5432/DATABASE
DATABASE_URL=

# Optional: force SSL when your Postgres provider requires it (Render usually does).
PGSSLMODE=require

# Directory containing the per-post JSON files used by the importer.
# Example: /home/runner/work/dashboard/dashboard/data/json
PROJECT_JSON_DATA_DIR=
